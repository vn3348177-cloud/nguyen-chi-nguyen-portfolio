
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Nguyễn Chí Nguyên — E-Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#132238; --navy-2:#1D3557; --accent:#D9642C; --accent-2:#F0965A;
    --steel:#3E6491; --bg:#F4F5F7; --card:#FFFFFF; --text:#1C2430;
    --muted:#5C6774; --border:#E1E4EA;
    font-family:'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){ --bg:#0E1520; --card:#161F2E; --text:#E7EAEF; --muted:#98A2B3; --border:#26303F; }
  }
  :root[data-theme="dark"]{ --bg:#0E1520; --card:#161F2E; --text:#E7EAEF; --muted:#98A2B3; --border:#26303F; }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth; scroll-padding-top: calc(64px + env(safe-area-inset-top,0px));}
  html,body{height:100%;}
  body{margin:0;background:var(--bg);color:var(--text);padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);line-height:1.55;}
  a{color:inherit;} img{max-width:100%;display:block;}
  .wrap{max-width:1040px;margin:0 auto;padding:0 24px;}
  .hidden{display:none;}

  nav.top{position:sticky;top:0;top:env(safe-area-inset-top,0px);z-index:60;background:var(--card);border-bottom:1px solid var(--border);}
  nav.top .inner{max-width:1040px;margin:0 auto;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;}
  .brand{font-weight:700;font-size:15px;color:var(--navy);cursor:pointer;}
  @media (prefers-color-scheme:dark){ .brand{color:var(--accent-2);} } :root[data-theme="dark"] .brand{color:var(--accent-2);}
  .brand span{color:var(--accent);}
  .navlinks{display:flex;gap:22px;flex-wrap:wrap;font-size:14px;font-weight:500;align-items:center;}
  .navlinks a,.navlinks button.navbtn{text-decoration:none;color:var(--muted);padding:4px 0;border-bottom:2px solid transparent;background:none;border-top:none;border-left:none;border-right:none;font-family:inherit;font-size:14px;font-weight:500;cursor:pointer;}
  .navlinks a:hover,.navlinks button.navbtn:hover{color:var(--accent);border-color:var(--accent);}
  .mode-badge{font-size:12px;font-weight:700;padding:5px 11px;border:1px solid var(--border);white-space:nowrap;}
  .mode-badge.can-edit{color:#2E7D32;border-color:#8FC98F;}
  .mode-badge.read-only{color:var(--muted);}

  .dropdown{position:relative;}
  .dropdown-panel{position:absolute;top:calc(100% + 14px);left:-14px;background:var(--card);border:1px solid var(--border);min-width:240px;box-shadow:0 10px 26px rgba(0,0,0,0.14);display:none;z-index:70;}
  .dropdown.open .dropdown-panel{display:block;}
  .dropdown-panel a{display:flex;align-items:center;gap:9px;padding:10px 14px;font-size:13.5px;color:var(--text);text-decoration:none;border-bottom:1px solid var(--border);}
  .dropdown-panel a:last-child{border-bottom:none;}
  .dropdown-panel a:hover{background:var(--bg);color:var(--accent);}
  .dcaret{font-size:10px;margin-left:2px;}

  header.hero{background:linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);color:#EEF2F8;padding:52px 24px 46px;position:relative;overflow:hidden;}
  header.hero::after{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(115deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 38px);pointer-events:none;}
  .hero-inner{max-width:1040px;margin:0 auto;position:relative;display:flex;gap:34px;align-items:center;flex-wrap:wrap;}
  .avatar{width:106px;height:106px;flex:none;border-radius:50%;background:radial-gradient(circle at 32% 28%, var(--accent-2), var(--accent) 65%, #b8501c 100%);display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:800;color:#fff;border:3px solid rgba(255,255,255,0.35);}
  .hero-text h1{margin:0 0 6px;font-size:clamp(26px,4vw,36px);font-weight:800;}
  .hero-text p.role{margin:0 0 14px;font-size:15.5px;color:#C7D3E3;font-weight:400;}
  .hero-tags{display:flex;gap:10px;flex-wrap:wrap;}
  .tag{font-size:12.5px;font-weight:600;padding:5px 12px;border:1px solid rgba(255,255,255,0.28);color:#EAF0F8;background:rgba(255,255,255,0.06);}

  .edit-hint{max-width:1040px;margin:18px auto 0;padding:0 24px;}
  .edit-hint .box{display:flex;gap:10px;align-items:flex-start;background:#EAF3EC;border:1px solid #BFE0C4;color:#245F2D;padding:10px 14px;font-size:13px;}
  @media (prefers-color-scheme:dark){ .edit-hint .box{background:#16281B;border-color:#2E4E33;color:#8FD79A;} }
  :root[data-theme="dark"] .edit-hint .box{background:#16281B;border-color:#2E4E33;color:#8FD79A;}

  main{padding:28px 0 80px;}
  section{margin-bottom:28px;}
  .card{background:var(--card);border:1px solid var(--border);border-left:4px solid var(--accent);padding:30px 30px 32px;}
  h2.section-title{display:flex;align-items:baseline;gap:10px;font-size:21px;font-weight:800;color:var(--navy);margin:0 0 20px;}
  @media (prefers-color-scheme:dark){ h2.section-title{color:#F1F5FB;} } :root[data-theme="dark"] h2.section-title{color:#F1F5FB;}
  h2.section-title .num{color:var(--accent);}

  [contenteditable="true"]{border-radius:2px;transition:background .12s;}
  [contenteditable="true"]:hover{background:rgba(217,100,44,0.08);outline:1px dashed var(--accent);}
  [contenteditable="true"]:focus{outline:2px solid var(--accent);background:rgba(217,100,44,0.12);}

  .intro-grid{display:grid;grid-template-columns:220px 1fr;gap:32px;}
  @media (max-width:640px){.intro-grid{grid-template-columns:1fr;}}
  .intro-photo{width:100%;aspect-ratio:1/1;background:linear-gradient(160deg,var(--navy-2),var(--navy));display:flex;align-items:center;justify-content:center;color:#fff;font-size:52px;font-weight:800;}
  dl.facts{margin:0 0 18px;display:grid;grid-template-columns:150px 1fr;row-gap:9px;column-gap:12px;font-size:14.5px;}
  dl.facts dt{color:var(--muted);font-weight:600;}
  dl.facts dd{margin:0;font-weight:500;}
  .bio{font-size:14.5px;}

  .gpa-banner{display:flex;align-items:center;gap:6px;flex-wrap:wrap;background:#FCEEE4;border:1px solid #F0C6A2;color:#7A3B12;padding:11px 16px;font-size:14px;font-weight:600;margin-bottom:20px;}
  @media (prefers-color-scheme:dark){ .gpa-banner{background:#2B1F14;border-color:#5C3A1C;color:#F0B27A;} } :root[data-theme="dark"] .gpa-banner{background:#2B1F14;border-color:#5C3A1C;color:#F0B27A;}
  .gpa-banner .star{color:var(--accent);}

  .tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;}
  .tab-btn{border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:inherit;font-size:13.5px;font-weight:600;padding:8px 16px;cursor:pointer;}
  .tab-btn:hover{border-color:var(--accent);}
  .tab-btn.active{background:var(--navy);border-color:var(--navy);color:#fff;}
  @media (prefers-color-scheme:dark){ .tab-btn.active{background:var(--accent);border-color:var(--accent);} } :root[data-theme="dark"] .tab-btn.active{background:var(--accent);border-color:var(--accent);}

  .table-scroll{overflow-x:auto;}
  table{width:100%;border-collapse:collapse;font-size:14px;min-width:560px;}
  th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--border);}
  th{color:var(--muted);font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;font-weight:700;}
  td.grade{font-weight:700;color:var(--navy);}
  @media (prefers-color-scheme:dark){ td.grade{color:var(--accent-2);} } :root[data-theme="dark"] td.grade{color:var(--accent-2);}
  td.num-col{width:34px;color:var(--muted);}
  th.del-col,td.del-col{width:30px;text-align:center;}
  .row-del{border:none;background:none;color:var(--muted);cursor:pointer;font-size:15px;line-height:1;padding:4px;}
  .row-del:hover{color:#C0392B;}
  .table-foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:13.5px;font-weight:600;color:var(--muted);margin-top:12px;padding-top:12px;border-top:1px solid var(--border);}
  .add-row-btn{margin-top:14px;border:1px dashed var(--border);background:none;color:var(--muted);font-family:inherit;font-size:13px;font-weight:600;padding:8px 14px;cursor:pointer;width:100%;}
  .add-row-btn:hover{border-color:var(--accent);color:var(--accent);}

  .lede{font-size:14px;color:var(--muted);margin:-8px 0 22px;max-width:70ch;}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  @media (max-width:640px){.grid-2{grid-template-columns:1fr;}}
  .wcard{border:1px solid var(--border);background:var(--bg);overflow:hidden;position:relative;}
  .wcard .thumb{height:130px;background:linear-gradient(135deg,var(--navy),var(--steel));display:flex;align-items:center;justify-content:center;color:#fff;font-size:12.5px;font-weight:600;letter-spacing:.03em;text-align:center;padding:0 16px;}
  .wcard .body{padding:18px 20px 20px;}
  .wcard h3{margin:0 0 8px;font-size:15.5px;font-weight:700;color:var(--navy);}
  @media (prefers-color-scheme:dark){ .wcard h3{color:#F1F5FB;} } :root[data-theme="dark"] .wcard h3{color:#F1F5FB;}
  .wcard p{margin:0 0 16px;font-size:13.5px;color:var(--muted);}
  .wlink{display:inline-flex;align-items:center;gap:6px;background:var(--navy);color:#fff;font-size:13px;font-weight:600;padding:8px 14px;text-decoration:none;border:none;cursor:pointer;font-family:inherit;}
  .wlink:hover{background:var(--accent);}
  .wcard-del{position:absolute;top:8px;right:8px;border:none;background:rgba(0,0,0,0.45);color:#fff;width:24px;height:24px;border-radius:50%;cursor:pointer;font-size:14px;line-height:1;}
  .wcard-del:hover{background:#C0392B;}
  .add-card-btn{border:1px dashed var(--border);background:none;color:var(--muted);font-family:inherit;font-size:13px;font-weight:600;padding:14px;cursor:pointer;min-height:100%;width:100%;}
  .add-card-btn:hover{border-color:var(--accent);color:var(--accent);}

  .skills-cols{display:grid;grid-template-columns:1fr 1fr;gap:36px;}
  @media (max-width:640px){.skills-cols{grid-template-columns:1fr;}}
  h4.sub{margin:0 0 12px;font-size:14.5px;font-weight:700;color:var(--navy);}
  @media (prefers-color-scheme:dark){ h4.sub{color:#F1F5FB;} } :root[data-theme="dark"] h4.sub{color:#F1F5FB;}
  ul.skill-list{list-style:none;margin:0;padding:0;}
  ul.skill-list li{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:13.5px;align-items:flex-start;}
  ul.skill-list li:last-child{border-bottom:none;}
  ul.skill-list li::before{content:"✓";color:var(--accent);font-weight:800;flex:none;}
  ul.skill-list li span.txt{flex:1;}
  .li-del{border:none;background:none;color:var(--muted);cursor:pointer;font-size:14px;}
  .li-del:hover{color:#C0392B;}
  .add-skill-btn{margin-top:8px;border:1px dashed var(--border);background:none;color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:600;padding:6px 12px;cursor:pointer;}
  .add-skill-btn:hover{border-color:var(--accent);color:var(--accent);}

  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:640px){.contact-grid{grid-template-columns:1fr;}}
  .contact-item{border:1px solid var(--border);padding:14px 16px;font-size:13.5px;}
  .contact-item dt{color:var(--muted);font-weight:600;margin-bottom:3px;font-size:12px;text-transform:uppercase;letter-spacing:.04em;}
  .contact-item dd{margin:0;font-weight:600;}

  footer{text-align:center;font-size:12.5px;color:var(--muted);padding:26px 24px 40px;}

  /* Detail report views */
  .crumbs{font-size:13px;color:#B8C3D6;margin-bottom:10px;}
  .crumbs button{background:none;border:none;color:#EAF0F8;text-decoration:underline;cursor:pointer;font-family:inherit;font-size:13px;padding:0;}
  .crumbs span{margin:0 6px;}
  .detail-hero p{margin:0;color:#C7D3E3;font-size:14.5px;max-width:70ch;}
  .info-box{background:var(--bg);border:1px solid var(--border);padding:18px 20px;display:grid;grid-template-columns:1fr 1fr;gap:12px 28px;font-size:14px;margin-bottom:26px;}
  @media (max-width:640px){.info-box{grid-template-columns:1fr;}}
  .info-box .f b{display:block;color:var(--muted);font-size:11.5px;text-transform:uppercase;letter-spacing:.03em;margin-bottom:2px;font-weight:700;}
  .info-box .f span{font-weight:600;}
  .equip-list{margin:0 0 22px;padding-left:20px;font-size:14px;}
  .equip-list li{margin-bottom:6px;}
  .media-row{display:grid;grid-template-columns:230px 1fr;gap:20px;margin-bottom:26px;align-items:start;}
  @media (max-width:640px){.media-row{grid-template-columns:1fr;}}
  .media-thumb{width:100%;aspect-ratio:4/3;background:linear-gradient(135deg,var(--steel),var(--navy));display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:600;text-align:center;padding:10px;}
  .media-row h4{margin:0 0 6px;font-size:14.5px;font-weight:700;color:var(--navy);}
  @media (prefers-color-scheme:dark){ .media-row h4{color:#F1F5FB;} } :root[data-theme="dark"] .media-row h4{color:#F1F5FB;}
  .media-row p{margin:0;font-size:13.5px;color:var(--muted);}
  .step{border-left:3px solid var(--accent);padding:2px 0 2px 16px;margin-bottom:20px;}
  .step h4{margin:0 0 6px;font-size:15px;font-weight:700;color:var(--navy);}
  @media (prefers-color-scheme:dark){ .step h4{color:#F1F5FB;} } :root[data-theme="dark"] .step h4{color:#F1F5FB;}
  .step p{margin:0 0 8px;font-size:14px;}
  .step .result{color:#2E7D32;font-weight:600;font-size:13.5px;}
  .mini-table{width:100%;border-collapse:collapse;font-size:13.5px;margin-top:10px;}
  .mini-table th,.mini-table td{border-bottom:1px solid var(--border);padding:8px 10px;text-align:left;}
  .mini-table th{color:var(--muted);font-size:11px;text-transform:uppercase;font-weight:700;}
  .mini-table td.pass{color:#2E7D32;font-weight:600;}
  .lessons-box{background:#FCEEE4;border:1px solid #F0C6A2;padding:16px 18px;font-size:14px;color:#5B3312;margin-bottom:10px;}
  @media (prefers-color-scheme:dark){ .lessons-box{background:#2B1F14;border-color:#5C3A1C;color:#F0B27A;} }
  :root[data-theme="dark"] .lessons-box{background:#2B1F14;border-color:#5C3A1C;color:#F0B27A;}
  .detail-nav{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:4px;}
  .btn-back,.btn-next,.btn-home{border:1px solid var(--border);background:var(--card);color:var(--text);font-weight:600;font-size:13.5px;padding:10px 18px;cursor:pointer;font-family:inherit;}
  .btn-next{border:none;background:var(--accent);color:#fff;}
  .btn-next:hover{background:#c1541f;} .btn-back:hover,.btn-home:hover{border-color:var(--accent);color:var(--accent);}
</style>
</head>
