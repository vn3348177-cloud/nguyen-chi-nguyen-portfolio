<script>
  function switchView(viewId, scrollToId){
    document.querySelectorAll('.view').forEach(v=>v.classList.add('hidden'));
    const v = document.getElementById(viewId);
    if(v) v.classList.remove('hidden');
    window.scrollTo({top:0, behavior:'instant' in window ? 'instant' : 'auto'});
    if(scrollToId){
      setTimeout(()=>{
        const el = document.getElementById(scrollToId);
        if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
      }, 30);
    }
  }
  function toggleDropdown(e){
    e.stopPropagation();
    document.getElementById('wsDropdown').classList.toggle('open');
  }
  function closeDropdown(){ document.getElementById('wsDropdown').classList.remove('open'); }
  document.addEventListener('click', ()=>{ closeDropdown(); });

  // Tab switching within Kết quả học tập (local per-viewer UI only)
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.add('hidden'));
      btn.classList.add('active');
      const panel = document.getElementById(btn.dataset.tab);
      if(panel) panel.classList.remove('hidden');
    });
  });

  function renumber(tbody){
    [...tbody.children].forEach((tr,i)=>{ const c = tr.querySelector('.num-col'); if(c) c.textContent = i+1; });
  }
  document.querySelectorAll('.row-del').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const tr = btn.closest('tr'); const tbody = tr.parentElement;
      tr.remove(); renumber(tbody);
    });
  });
  document.querySelectorAll('.add-row-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const tbody = document.getElementById(btn.dataset.target);
      const tr = document.createElement('tr');
      tr.id = btn.dataset.target + '-new-' + Date.now();
      tr.innerHTML = '<td class="num-col"></td>'+
        '<td contenteditable="true">Tên môn học mới</td>'+
        '<td contenteditable="true">3</td>'+
        '<td class="grade" contenteditable="true">0.0</td>'+
        '<td contenteditable="true">—</td>'+
        '<td class="del-col"><button class="row-del">×</button></td>';
      tbody.appendChild(tr); renumber(tbody);
      tr.querySelector('.row-del').addEventListener('click', ()=>{ tr.remove(); renumber(tbody); });
      tr.querySelectorAll('[contenteditable]')[0].focus();
    });
  });

  document.getElementById('workshopGrid').addEventListener('click', (e)=>{
    if(e.target.classList.contains('wcard-del')){ e.target.closest('.wcard').remove(); }
  });
  document.getElementById('addWorkshopCard').addEventListener('click', ()=>{
    const grid = document.getElementById('workshopGrid');
    const card = document.createElement('div');
    card.className = 'wcard'; card.id = 'wc-new-' + Date.now();
    card.innerHTML = '<button class="wcard-del" title="Xoá thẻ">×</button>'+
      '<div class="thumb" contenteditable="true">TÊN BÀI THỰC HÀNH</div>'+
      '<div class="body">'+
      '<h3 contenteditable="true">Bài thực hành mới</h3>'+
      '<p contenteditable="true">Mô tả ngắn về quy trình, dụng cụ và kết quả đo kiểm.</p>'+
      '<button class="wlink">👉 Xem báo cáo chi tiết trang con →</button>'+
      '</div>';
    grid.appendChild(card); card.querySelector('h3').focus();
  });

  document.querySelectorAll('.skill-list').forEach(list=>{
    list.addEventListener('click', (e)=>{
      if(e.target.classList.contains('li-del')){ e.target.closest('li').remove(); }
    });
  });
  document.querySelectorAll('.add-skill-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const list = document.getElementById(btn.dataset.target);
      const li = document.createElement('li');
      li.innerHTML = '<span class="txt" contenteditable="true">Nội dung mới…</span><button class="li-del">×</button>';
      list.appendChild(li); li.querySelector('.txt').focus();
    });
  });

  (async ()=>{
    const badge = document.getElementById('modeBadge');
    try{
      const user = await claude.use('user');
      const editable = user ? (user.canEdit ? user.canEdit() : true) : true;
      if(editable){
        badge.textContent = '✏️ Bạn có thể chỉnh sửa'; badge.className = 'mode-badge can-edit';
      } else {
        badge.textContent = '👁 Chỉ xem'; badge.className = 'mode-badge read-only';
        const hint = document.getElementById('editHint'); if(hint) hint.style.display = 'none';
        document.querySelectorAll('[contenteditable="true"]').forEach(el=>el.removeAttribute('contenteditable'));
        document.querySelectorAll('.add-row-btn,.row-del,.wcard-del,.add-card-btn,.add-skill-btn,.li-del').forEach(el=>el.style.display='none');
      }
    }catch(e){
      badge.textContent = '✏️ Có thể chỉnh sửa'; badge.className = 'mode-badge can-edit';
    }
  })();
</script>

